# WOOD — Hostinger / Apache production defaults.
# This file is used only by Apache-based hosts such as the Hostinger PHP/HTML
# plan. It does not change the GitHub Pages or Cloudflare Pages deployment.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co https://challenges.cloudflare.com; frame-src 'self' https://*.viva.com https://*.vivapayments.com; form-action 'self' https://*.viva.com https://*.vivapayments.com"

  # HTML and account/order pages must always revalidate so a new release is
  # visible immediately without serving a stale private view.
  <FilesMatch "\.(?:html?|htm)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  # CSS/JS/media already carry release query strings in the public HTML. Keep
  # a bounded cache for performance while requiring validation at expiry.
  <FilesMatch "\.(?:css|js|mjs|svg|webp|png|jpe?g|ico|woff2?)$">
    Header always set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
</IfModule>
